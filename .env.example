# Copy to .env for `docker compose up`.  ── = required for a production deploy.

# Postgres password (used by both the postgres and rya services).
POSTGRES_PASSWORD=rya

# Optional — set to use real Claude for ctx.llm instead of the deterministic mock.
# Leave blank for offline/local development.
ANTHROPIC_API_KEY=
RYA_LLM_MODEL=claude-haiku-4-5-20251001

# ── Operator auth. UNSET = the control plane is OPEN (anyone can drive it).
#    Generate one with `rya token`. Required on `/mcp` (remote MCP) too.
RYA_TOKEN=

# ── Encryption-at-rest key for connection secrets (a Fernet key). UNSET = a
#    dev keyfile is generated next to the data (NOT safe for prod) and, if
#    cryptography is missing, secrets are stored PLAINTEXT.
#    Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RYA_SECRET_KEY=

# ── Require signed inbound webhooks (HMAC-SHA256 X-Rya-Signature). UNSET =
#    /inbound accepts unsigned events.
RYA_WEBHOOK_SECRET=

# Multi-tenant mode (per-workspace API keys + Postgres RLS). Needs Postgres.
RYA_MULTITENANT=
# ── Required when RYA_MULTITENANT=1: gates self-serve project provisioning
#    (POST /v1/projects). UNSET in multi-tenant = provisioning is refused.
RYA_ADMIN_TOKEN=
# ── Required when RYA_MULTITENANT=1: password for the non-superuser rya_app
#    data-plane role. UNSET falls back to an insecure default — set a strong one.
#    `tenancy.setup()` gives rya_worker this same password.
RYA_APP_DB_PASSWORD=

# ── Strongly recommended when RYA_MULTITENANT=1: the execution plane's own DSN.
#    Empty derives the rya_worker role from RYA_DATABASE_URL, which leaves the
#    ADMIN DSN in the worker's environment — and superusers bypass RLS entirely,
#    which would make every policy `tenancy.setup()` installs decorative for
#    exactly the process they exist to constrain. Setting it also removes the
#    admin DSN from that environment, which is the actual goal.
# RYA_WORKER_DATABASE_URL=postgresql://rya_worker:<RYA_APP_DB_PASSWORD>@postgres:5432/rya

# Which two workspaces the tenant claimers in docker-compose.multitenant.yml serve
# (`rya workspaces list` for the ids). One claimer per tenant is a worked example,
# not a scaling plan — `rya supervisor --all-workspaces` is what runs a real fleet.
# RYA_WORKSPACE_A=ws_…
# RYA_WORKSPACE_B=ws_…

# The agent project mounted at /project (api + worker). Must contain
# rya.agent.yaml. Point it at any project tree:
#   RYA_PROJECT=../rya-examples/chat-agent
RYA_PROJECT=./examples/followup_agent

# Bundle archive store — where `rya publish` puts a version's artifact and a
# pinned worker fetches it from. Defaults to the compose `minio` service.
#
# Set the bucket EMPTY (not unset) to fall back to a local directory instead;
# that only works if the api and workers share a filesystem.
#
# On real AWS: set the bucket, leave the ENDPOINT blank (S3 wants virtual-host
# addressing, and a declared endpoint forces path-style for MinIO/Ceph/R2).
RYA_BUNDLES_S3_BUCKET=rya-bundles
RYA_BUNDLES_S3_ENDPOINT=http://minio:9000
RYA_BUNDLES_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret

# Largest bundle the publish endpoint accepts (bytes, default 20MB). Anything in
# front of the api has its own limit — nginx defaults client_max_body_size to 1MB
# — and a proxy's 413 will not carry a Rya error code.
# RYA_MAX_BUNDLE_BYTES=20971520

# Allow `rya publish` while RYA_TOKEN is unset. Publishing to an OPEN control
# plane means anonymous code upload to a box whose worker imports it, so it is
# refused by default even though every other route is open in that mode.
# RYA_ALLOW_UNAUTHENTICATED_PUBLISH=1

# Per-user identity via JWT (single-tenant). Set one of these to enforce JWT auth.
# RYA_JWT_SECRET=
# RYA_JWKS_URL=

# Observability export (optional).
# LANGFUSE_HOST=
# RYA_TRACE_WEBHOOK=

# Advanced: override the DB connection (defaults to the compose postgres service).
# RYA_DATABASE_URL=postgresql://user:pass@host:5432/dbname
