# Copy to .env for `docker compose up`.

# Postgres password (used by both the postgres and rya services).
POSTGRES_PASSWORD=rya

# Optional — set to use real Claude for ctx.llm instead of the deterministic mock.
# Leave blank for offline/local development.
ANTHROPIC_API_KEY=
RYA_LLM_MODEL=claude-haiku-4-5-20251001

# Advanced: override the DB connection (defaults to the compose postgres service).
# RYA_DATABASE_URL=postgresql://user:pass@host:5432/dbname
