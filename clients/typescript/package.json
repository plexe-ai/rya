{
  "name": "@plexe/rya",
  "version": "0.1.0",
  "description": "TypeScript client for the Rya agent runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc && tsc -p tsconfig.check.json",
    "test": "tsc && node --test \"test/*.test.mjs\" && tsc -p tsconfig.check.json",
    "smoke": "node smoke.mjs"
  },
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "devDependencies": { "typescript": "^5.5.0" }
}
