# Rya control-plane image for ECS Fargate — rya + a baked agent project.
# Built for linux/arm64 (the task definition runs ARM64 Fargate).
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# `s3` (boto3) is required, not optional: template.yaml sets RYA_FILES_S3_BUCKET on
# both task definitions, and `files_s3` needs boto3 to honour it — without this the
# first file offload fails at runtime. It is also what the bundle store's S3 arm
# needs if a bundles bucket is ever added (see README).
RUN pip install --no-cache-dir '.[api,postgres,llm,mcp,s3]'

# Bake a fresh agent project at /project (rya serve runs against it).
RUN cd / && rya create project

WORKDIR /project
EXPOSE 8787
CMD ["rya", "serve", "--host", "0.0.0.0", "--port", "8787"]
