# Rya runtime image baking a SPECIFIC agent project (vs Dockerfile.baked, which
# scaffolds the default minimal agent). Build with:
#   docker buildx build --platform linux/arm64 -f deploy/aws/Dockerfile.project \
#     --build-arg PROJECT=examples/csa-counsellor -t <ecr>/rya-control-plane:<tag> --push .
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# `s3` is declared rather than inherited: this image happened to get boto3 via the
# `[bedrock]` layer below, so RYA_FILES_S3_BUCKET worked by accident. Dropping
# Bedrock would have broken file offload with no obvious connection.
RUN pip install --no-cache-dir '.[api,postgres,llm,mcp,s3]'
# Bedrock provider (IAM-signed model calls) - separate layer to keep the big
# install cached.
RUN pip install --no-cache-dir '.[bedrock]' pypdf

ARG PROJECT
COPY ${PROJECT} /project

WORKDIR /project
EXPOSE 8787
CMD ["rya", "serve", "--host", "0.0.0.0", "--port", "8787"]
